{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "baseBranches": ["master"],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "labels": ["dependencies"],
  "minimumReleaseAge": "60 days",
  "pinVersions": true,
  "packageRules": [
    {
      "description": "Block @verdaccio/streams from being updated",
      "matchPackageNames": ["@verdaccio/streams"],
      "enabled": false
    },
    {
      "description": "Verdaccio packages — update immediately, no age gate",
      "matchPackagePatterns": ["^@verdaccio/"],
      "groupName": "verdaccio",
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"],
      "automerge": false,
      "prPriority": 10
    },
    {
      "description": "Google Cloud SDK — group and update monthly",
      "matchPackagePatterns": ["^@google-cloud/"],
      "groupName": "google-cloud-sdk",
      "schedule": ["before 6am on the first day of the month"],
      "automerge": false
    },
    {
      "description": "Build tooling — group and update monthly",
      "matchPackageNames": [
        "vite",
        "vite-plugin-dts",
        "vitest",
        "typescript",
        "rimraf",
        "cross-env"
      ],
      "groupName": "build-tooling",
      "schedule": ["before 6am on the first day of the month"],
      "automerge": false
    },
    {
      "description": "Type definitions — group and update monthly",
      "matchPackagePatterns": ["^@types/"],
      "groupName": "type-definitions",
      "schedule": ["before 6am on the first day of the month"],
      "automerge": false
    },
    {
      "description": "All other dependencies — monthly",
      "matchPackagePatterns": ["*"],
      "excludePackagePatterns": [
        "^@verdaccio/",
        "^@google-cloud/",
        "^@types/",
        "^oxlint",
        "^oxfmt"
      ],
      "excludePackageNames": [
        "vite",
        "vite-plugin-dts",
        "vitest",
        "typescript",
        "rimraf",
        "cross-env"
      ],
      "groupName": "other-dependencies",
      "schedule": ["before 6am on the first day of the month"],
      "automerge": false
    },
    {
      "description": "oxlint and oxfmt — move fast, gate at the 7 days pnpm-workspace.yaml enforces",
      "matchPackagePatterns": ["^oxlint", "^oxfmt"],
      "groupName": "oxlint & oxfmt",
      "groupSlug": "oxlint-oxfmt",
      "minimumReleaseAge": "7 days"
    }
  ]
}
